# ConnectSphere Server Environment Template
# Copy this file to .env and configure values for your deployment

# Server Port & Mode
PORT=5000
NODE_ENV=production
CLIENT_URL=https://connectsphere.example.com

# Database Connection
# Local Development: "file:./dev.db" (SQLite)
# Production: "postgresql://username:password@hostname:5432/connectsphere?sslmode=require" (PostgreSQL / Neon / Supabase)
DATABASE_URL="file:./dev.db"

# JWT Authentication Security
# Generate a strong 64-character random secret for production
JWT_SECRET="your_production_secret_key_minimum_32_characters"
JWT_EXPIRES_IN="7d"

# File Sharing & Upload Security
MAX_FILE_SIZE_MB=15
UPLOAD_DIR="./uploads"
