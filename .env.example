# ConnectSphere Environment Configuration

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Prisma SQLite by default, easily swapped with PostgreSQL)
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET="connectsphere_super_secret_jwt_key_change_in_production_2026"
JWT_EXPIRES_IN="7d"

# File Storage
MAX_FILE_SIZE_MB=15
UPLOAD_DIR="./uploads"
