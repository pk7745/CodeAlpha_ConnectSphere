# ConnectSphere Environment Template
# ==============================================================================
# LOCAL DEVELOPMENT CONFIGURATION (Default)
# ==============================================================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL="file:./dev.db"
JWT_SECRET="connectsphere_super_secret_jwt_key_change_in_production_2026"
JWT_EXPIRES_IN="7d"
MAX_FILE_SIZE_MB=15
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"

# Optional Server-Side Google Gemini AI Key
GEMINI_API_KEY=""

# ==============================================================================
# PRODUCTION (RENDER FREE TIER + NEON POSTGRESQL + SUPABASE STORAGE FREE TIER)
# ==============================================================================
# NODE_ENV=production
# PORT=10000
# CLIENT_URL=https://<your-client>.onrender.com
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# JWT_SECRET=<generate_secure_random_64_char_secret>
# JWT_EXPIRES_IN=7d
# STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://<your-project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<your_supabase_service_role_secret_key>
# SUPABASE_STORAGE_BUCKET=connectsphere-files
# GEMINI_API_KEY=<optional_gemini_api_key>

# ==============================================================================
# FRONTEND CLIENT (client/.env)
# ==============================================================================
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
# In production:
# VITE_API_URL=https://<your-server>.onrender.com
# VITE_SOCKET_URL=https://<your-server>.onrender.com
