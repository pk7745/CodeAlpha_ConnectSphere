# ConnectSphere Environment Template
# ==============================================================================
# LOCAL DEVELOPMENT CONFIGURATION (Default)
# ==============================================================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL="file:./dev.db"
JWT_SECRET="connectsphere_super_secret_jwt_key_change_in_production_2026"
JWT_EXPIRES_IN="7d"
MAX_FILE_SIZE_MB=15
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"

# Optional Server-Side Google Gemini AI Key
GEMINI_API_KEY=""

# ==============================================================================
# PRODUCTION (RENDER FREE TIER + NEON POSTGRESQL + CLOUD OBJECT STORAGE)
# ==============================================================================
# NODE_ENV=production
# PORT=10000
# CLIENT_URL=https://<your-client>.onrender.com
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# JWT_SECRET=<generate_secure_random_64_char_secret>
# JWT_EXPIRES_IN=7d
# STORAGE_PROVIDER=cloud
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_BUCKET=connectsphere-uploads
# S3_ACCESS_KEY_ID=<r2_or_s3_access_key>
# S3_SECRET_ACCESS_KEY=<r2_or_s3_secret_key>
# S3_REGION=auto
# GEMINI_API_KEY=<optional_gemini_api_key>

# ==============================================================================
# FRONTEND CLIENT (client/.env)
# ==============================================================================
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
# In production:
# VITE_API_URL=https://<your-server>.onrender.com
# VITE_SOCKET_URL=https://<your-server>.onrender.com
